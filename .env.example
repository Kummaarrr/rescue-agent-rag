# Copy to .env and fill in. Never commit .env.

# LLM provider (Claude). If ANTHROPIC_API_KEY is already set in your shell, that value wins.
ANTHROPIC_API_KEY=

# Embeddings (Anthropic has no embeddings API). Leave empty to use the local embedding model.
VOYAGE_API_KEY=

# SEC EDGAR fair-access policy requires a User-Agent with contact details
SEC_USER_AGENT="Your Name your.email@example.com"

# Vector store: leave QDRANT_URL empty to use embedded local mode at QDRANT_PATH
QDRANT_URL=
QDRANT_PATH=./qdrant_storage

# Cost guard: the eval runner stops if a run is projected to cost more than this
MAX_RUN_COST_USD=5

# Tracing (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
